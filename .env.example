# ==============================================================================
# Toko Marcell — Local Environment Configuration
# ==============================================================================
# Required for Toko Marcell AI Copilot:
# Get your free key at Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Database (pre-configured for docker compose pgvector container)
DATABASE_URL=postgresql://toko:toko@db:5432/toko

# API URLs (pre-configured for docker compose)
NEXT_PUBLIC_API_URL=http://localhost:8001
INTERNAL_API_URL=http://api:8000
