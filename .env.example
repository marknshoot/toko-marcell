# ==============================================================================
# Toko Marcell — Local Environment Configuration
# ==============================================================================
# AI Copilot provider (docker compose injects these into the api container).
# Pick one primary provider below. LLM_MODEL / LLM_BASE_URL are shared by every
# OpenAI-compatible provider, so switching providers means swapping those two.

# ── Primary: OpenRouter (OpenAI-compatible, the default) ─────────────────────
# Used whenever OPENROUTER_API_KEY is set.
# Keys: https://openrouter.ai/keys  ·  Free models: https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=openrouter/free
LLM_BASE_URL=https://openrouter.ai/api/v1
# Optional: comma-separated fallbacks if you pin a specific LLM_MODEL above
# LLM_FALLBACK_MODELS=

# ── Alternative primary: Mistral AI (direct, OpenAI-compatible) ─────────────
# Smallest, fastest Mistral tier with good Indonesian coverage. This branch
# turns on when LLM_BASE_URL contains "mistral", and then MISTRAL_API_KEY wins
# over OPENROUTER_API_KEY. A bare MISTRAL_API_KEY (no base-URL change) is also
# accepted as a key fallback for OpenRouter.
# To switch: comment out the OpenRouter LLM_MODEL + LLM_BASE_URL lines above,
# then uncomment all three lines below.
# Keys: https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=your_mistral_api_key_here
# LLM_MODEL=ministral-8b-latest
# LLM_BASE_URL=https://api.mistral.ai/v1

# ── Fallback: Google Gemini (appended after the primary in the chain) ───────
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Unit economics (planning estimate; not a provider invoice) ───────────────
# USD per one million tokens, used by copilot_turns.cost_usd and unit_economics.
# LLM_INPUT_COST_PER_MILLION=0.15
# LLM_OUTPUT_COST_PER_MILLION=0.60

# Guardrail classifier mode: "always" (contextual default) or "ambiguous"
# (deterministic regex labels skip the LLM; only ambiguous messages use it).
# GUARDRAIL_LLM_MODE=always

# Database (pre-configured for docker compose pgvector container)
DATABASE_URL=postgresql://toko:toko@db:5432/toko

# Admin token for POST /search/reindex and as a legacy fallback for /admin/kpi.
# The dashboard itself uses Argon2id login + a short-lived JWT.
ADMIN_TOKEN=dev-admin-token

# ── Admin authentication (Argon2id + dual JWT) ───────────────────────────────
# CHANGE THIS IN PRODUCTION. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=dev-admin-jwt-secret-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Proxy trust: set true on Render (behind their load balancer) for correct client IP
TRUST_PROXY=false

# ── Search feature flags (memory-constrained deployments) ────────────────────
# Dense retrieval defaults to the vocabulary-pruned multilingual model:
# 113k Latin/ID/EN tokens, 124 MB ONNX, ~380 MB RSS with one ONNX thread and
# the CPU memory arena disabled. That fits Render's 512 MB free tier, so hybrid
# dense + lexical search is enabled by default. Set false only on hosts where
# even the pruned model does not fit; /search then uses BM25 only and
# mode=dense falls back to BM25 instead of returning no results.
# ENABLE_DENSE_SEARCH=true
# TEXT_EMBED_MODEL=Marcell-Kristianto/paraphrase-multilingual-MiniLM-L12-v2-id-en-onnx
# Optional cross-encoder stage-2 reranking (off by default for the same reason).
# ENABLE_RERANKER=false

# Copilot rate limits (per client IP)
# COPILOT_RATE_LIMIT_PER_MIN=10
# COPILOT_RATE_LIMIT_PER_DAY=100

# Allowed hosts for copilot image fetch (comma-separated, HTTPS only)
# IMAGE_FETCH_ALLOWED_HOSTS=images-na.ssl-images-amazon.com,m.media-amazon.com

# API URLs (pre-configured for docker compose)
NEXT_PUBLIC_API_URL=http://localhost:8001
INTERNAL_API_URL=http://api:8000
