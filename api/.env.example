# Toko Marcell AI Copilot - Environment Configuration
# Copy this file to `api/.env` and insert your Google Gemini API key.

# Google Gemini API Key (Dapatkan gratis di https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Model: gemini-3.5-flash-lite (default, free tier) atau gemini-flash-latest
GEMINI_MODEL=gemini-3.5-flash-lite

# PostgreSQL & pgvector Database URL
DATABASE_URL=postgresql://toko:toko@localhost:5432/toko
