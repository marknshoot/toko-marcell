# Toko Marcell AI Copilot - Environment Configuration
# Copy this file to `api/.env` and fill in your keys.

# ── Preferred provider: OpenRouter (OpenAI-compatible) ────────────────────────
# The copilot prefers OpenRouter whenever OPENROUTER_API_KEY is set. The free
# text-model tier allows ~1000 requests/day on an account with >= $10 credit,
# which is far more generous than the Gemini free tier.
# Keys: https://openrouter.ai/keys  ·  Free models: https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=openrouter/free
LLM_BASE_URL=https://openrouter.ai/api/v1
# Optional: comma-separated fallbacks if you pin a specific LLM_MODEL above
# LLM_FALLBACK_MODELS=

# ── Fallback provider: Google Gemini ──────────────────────────────────────────
# Used only when OPENROUTER_API_KEY is empty.
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Unit economics (planning estimate; not a provider invoice) ───────────────
# USD per one million tokens, used by copilot_turns.cost_usd and unit_economics.
# LLM_INPUT_COST_PER_MILLION=0.15
# LLM_OUTPUT_COST_PER_MILLION=0.60

# Guardrail classifier mode: "always" (contextual default) or "ambiguous"
# (deterministic regex labels skip the LLM; only ambiguous messages use it).
# GUARDRAIL_LLM_MODE=always

# PostgreSQL & pgvector Database URL
DATABASE_URL=postgresql://toko:toko@localhost:5432/toko

# ── Admin authentication (Argon2id + dual JWT) ───────────────────────────────
# CHANGE THIS IN PRODUCTION. Generate with: openssl rand -hex 32
# JWT_SECRET_KEY=dev-admin-jwt-secret-change-in-prod
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7
