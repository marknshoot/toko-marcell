# Toko Marcell AI Copilot - Environment Configuration
# Copy this file to `api/.env` and insert your actual OpenRouter API key.

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM Model Configuration
LLM_MODEL=google/gemini-2.5-flash
LLM_BASE_URL=https://openrouter.ai/api/v1

# PostgreSQL & pgvector Database URL
DATABASE_URL=postgresql://toko:toko@localhost:5432/toko
